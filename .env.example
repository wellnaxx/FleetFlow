# =========================
# Application Configuration
# =========================
PERSISTENCE_BACKEND=postgres

# =========================
# PostgreSQL Database
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fleetflow
DB_USER=postgres
DB_PASSWORD=your_password_here

# =========================
# Local JSON Storage
# =========================
JSON_STATE_PATH=state.json
JSON_USER_STORE=users.json
JSON_EXPORT_DIR=exports

# =========================
# JWT Authentication
# =========================
# Generate both with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_random_access_secret_from_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_random_refresh_secret_from_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =========================
# Application Configuration
# =========================
# Supported values: memory, postgres.
# In postgres mode, users are read from the PostgreSQL users table; users.json is not used.
PERSISTENCE_BACKEND=postgres

# =========================
# PostgreSQL Database
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fleetflow
DB_USER=postgres
DB_PASSWORD=your_password_here

# =========================
# Local JSON Storage
# =========================
JSON_STATE_PATH=state.json
JSON_USER_STORE_PATH=users.json
JSON_EXPORT_DIR=exports

# =========================
# JWT Authentication
# =========================
# Generate each secret independently with: openssl rand -hex 32
# Secrets must be different random values, not human-chosen phrases.
JWT_ACCESS_SECRET=replace_with_random_access_secret_from_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_random_refresh_secret_from_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =========================
# Logger Config
# =========================
LOG_LEVEL=INFO
# Optional. Omit to log to stdout only.
LOG_FILE=fleetflow.log
